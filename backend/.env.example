# Copier ce fichier en .env puis renseigner vos propres valeurs.
# Le fichier .env n'est jamais versionné (voir .gitignore).

DB_HOST=localhost
DB_PORT=5432
DB_NAME=integrateur_web_db
DB_USER=votre_utilisateur
DB_PASSWORD=votre_mot_de_passe

# Origines autorisées par CORS, séparées par des virgules.
# Ajoutez ici l'URL de production si le frontend est servi ailleurs.
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
